<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="96dp"
    android:background="@drawable/bg_home_card"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Biểu tượng loại giao dịch -->
    <TextView
        android:id="@+id/txtHistoryIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_package_active"
        android:gravity="center"
        android:text="↓"
        android:textColor="#13976E"
        android:textSize="25sp"
        android:textStyle="bold"/>

    <!-- Tên và thời gian giao dịch -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHistoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nạp tiền tài khoản"
            android:textColor="#15335C"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="07/11/2026 • 15:00"
            android:textColor="#8192AD"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Số tiền và trạng thái -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHistoryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+50.000đ"
            android:textColor="#13976E"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Thành công"
            android:textColor="#13976E"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
