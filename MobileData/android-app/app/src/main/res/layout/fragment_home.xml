<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Đầu trang: hiển thị đúng thông tin tài khoản đang đăng nhập. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xin chào,"
                android:textColor="#E0ECFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtHomeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Người dùng MobileData"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHomeToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="dd/MM/yyyy"
                android:textColor="#E0ECFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtHomePhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0917 443 781"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHomeCarrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="VinaPhone"
                    android:textColor="#2455B6"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Số dư đã tách riêng theo thuê bao bằng DemoAccountStore. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_home_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SỐ DƯ TÀI KHOẢN"
                android:textColor="#8192AD"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtHomeBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="22.531đ"
                android:textColor="#15335C"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Số dư mô phỏng, chưa kết nối nhà mạng"
                android:textColor="#8192AD"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Hàng nút thao tác nhanh. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="22dp"
            android:text="Tiện ích nhanh"
            android:textColor="#15335C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actionHomeBuy"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Mua gói"
                android:textColor="#2463EB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/actionHomeManage"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Gói đang dùng"
                android:textColor="#2463EB"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actionHomeTopup"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Nạp tiền"
                android:textColor="#2463EB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/actionHomeHistory"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Lịch sử"
                android:textColor="#2463EB"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="24dp"
            android:text="Gói cước đang sử dụng"
            android:textColor="#15335C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Thẻ này chỉ hiện khi gói DATA12 của thuê bao còn hiệu lực. -->
        <LinearLayout
            android:id="@+id/cardHomeActivePlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtHomePackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA12"
                android:textColor="#15335C"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHomePackageInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="1GB/ngày • 12.000đ"
                android:textColor="#8192AD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtHomePackageRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Còn 4 giờ"
                android:textColor="#245BDE"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressHomePackage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressTint="#2463EB" />

            <TextView
                android:id="@+id/txtHomePackageProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đã sử dụng 0% thời hạn"
                android:textColor="#8192AD"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtHomePackageWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_warning"
                android:padding="12dp"
                android:text="Gói cước sắp hết hạn"
                android:textColor="#995F0D"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHomeManagePackage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#2463EB"
                android:text="Quản lý gói"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Không có gói hoạt động thì hiện thẻ trống, không tạo gói mới. -->
        <LinearLayout
            android:id="@+id/cardHomeEmptyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có gói cước đang sử dụng"
                android:textColor="#15335C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Gói đã hết hạn hoặc hủy sẽ không tự gia hạn. Nhấn để xem gói mới."
                android:textColor="#8192AD"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_home_banner"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tìm gói cước phù hợp với bạn"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Xem thông tin các gói cước mô phỏng"
                android:textColor="#E0ECFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnHomeBanner"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#FFFFFF"
                android:text="Khám phá gói cước"
                android:textAllCaps="false"
                android:textColor="#245BDE" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gói cước đề xuất"
                android:textColor="#15335C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHomeSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:text="Tất cả ›"
                android:textColor="#2463EB"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/recommendContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
