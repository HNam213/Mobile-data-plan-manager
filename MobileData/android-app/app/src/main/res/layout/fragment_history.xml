<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- PHẦN 1: ĐẦU TRANG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lịch sử giao dịch"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Theo dõi các khoản nạp tiền và đăng ký gói cước"
                android:textColor="#E0ECFF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="◉  0917 443 781  •  VinaPhone"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- PHẦN 2: THỐNG KÊ GIAO DỊCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Tổng tiền nạp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tổng tiền đã nạp"
                    android:textColor="#8192AD"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtHistoryTotalTopup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="0đ"
                    android:textColor="#13976E"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Tổng tiền đăng ký gói -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tổng tiền đăng ký"
                    android:textColor="#8192AD"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtHistoryTotalSpent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="0đ"
                    android:textColor="#D94848"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- PHẦN 3: BỘ LỌC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterHistoryAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_chip"
                android:gravity="center"
                android:text="Tất cả"
                android:textColor="#2463EB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/filterHistoryTopup"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="Nạp tiền"
                android:textColor="#8192AD"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/filterHistoryRegister"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="Đăng ký gói"
                android:textColor="#8192AD"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- PHẦN 4: DANH SÁCH GIAO DỊCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="23dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách giao dịch"
                android:textColor="#15335C"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtHistoryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 giao dịch"
                android:textColor="#8192AD"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Java sẽ thêm các thẻ giao dịch vào đây -->
        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"/>

        <!-- Hiện thông báo nếu không có giao dịch -->
        <TextView
            android:id="@+id/txtHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:gravity="center"
            android:minHeight="150dp"
            android:padding="20dp"
            android:text="Chưa có giao dịch nào"
            android:textColor="#8192AD"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Lịch sử hiện được lưu trên thiết bị để thử nghiệm."
            android:textColor="#9BAAC0"
            android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
