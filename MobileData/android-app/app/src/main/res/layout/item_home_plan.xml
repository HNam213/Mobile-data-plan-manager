<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="154dp"
    android:layout_height="192dp"
    android:orientation="vertical"
    android:background="@drawable/bg_home_card"
    android:elevation="2dp">

    <!-- Phần màu xanh hiển thị thông tin gói -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="158dp"
        android:background="@drawable/bg_home_plan"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPlanName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DT30"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtPlanBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="Rẻ nhất"
                android:textColor="#2455B6"
                android:textSize="9sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtPlanData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="7GB/7 ngày"
            android:textColor="#D6E8FF"
            android:textSize="12sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtPlanPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30.000đ"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtPlanPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/7 ngày"
            android:textColor="#D6E8FF"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Phần chân thẻ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VinaPhone"
            android:textColor="#2463EB"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/txtPlanRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 4.7"
            android:textColor="#E9A52B"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
