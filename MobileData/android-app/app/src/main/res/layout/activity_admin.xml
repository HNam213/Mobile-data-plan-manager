<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Tiêu đề trang quản trị -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản trị MobileData"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Quản lý thông tin và hoạt động của hệ thống"
                android:textColor="#E0ECFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="Dữ liệu trực tiếp từ SQL Server"
                android:textColor="#2455B6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tổng quan danh mục demo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="Tổng quan hệ thống"
            android:textColor="#15335C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAdminCountCarriers"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="3\nNhà mạng"
                android:textColor="#2463EB"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminCountPlans"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="6\nGói cước"
                android:textColor="#2463EB"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAdminCountSubscribers"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="2\nTài khoản demo"
                android:textColor="#13976E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminCountSupport"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="2\nYêu cầu hỗ trợ"
                android:textColor="#D78612"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lối vào thống kê ADMIN -->
        <Button
            android:id="@+id/btnAdminStatistics"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#245BDE"
            android:text="Xem báo cáo hệ thống"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAdminRegisterOwner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#13976E"
            android:text="Đăng ký hồ sơ khách hàng"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAdminManageOwners"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="9dp"
            android:backgroundTint="#2463EB"
            android:text="Quản lý khách hàng  •  Thêm / Sửa / Xóa"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="Danh mục quản lý"
            android:textColor="#15335C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAdminCarriers"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_chip"
                android:gravity="center"
                android:text="Nhà mạng"
                android:textColor="#2463EB"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabAdminPlans"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="Gói cước"
                android:textColor="#8192AD"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAdminSubscribers"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="Thuê bao"
                android:textColor="#8192AD"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabAdminSupport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:gravity="center"
                android:text="Hỗ trợ"
                android:textColor="#8192AD"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Lọc rõ gói/thuê bao/yêu cầu hỗ trợ theo nhà mạng. -->
        <Spinner
            android:id="@+id/spAdminCarrierFilter"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_card"
            android:paddingHorizontal="12dp" />

        <!-- Tìm kiếm danh mục quản lý -->
        <EditText
            android:id="@+id/edtAdminSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_home_card"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="Tìm kiếm trong danh mục..."
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#15335C"
            android:textColorHint="#637897"
            android:textStyle="bold"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAdminSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách nhà mạng"
                android:textColor="#15335C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdminAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginEnd="8dp"
                android:text="+ Thêm"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2463EB" />

            <TextView
                android:id="@+id/txtAdminSectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 mục"
                android:textColor="#8192AD"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/adminListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtAdminEmpty"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:gravity="center"
            android:text="Không có dữ liệu phù hợp"
            android:textColor="#8192AD"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAdminBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2463EB"
            android:text="Quay về tài khoản"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Quản lý thực hiện qua Web API, có kiểm tra quyền ADMIN."
            android:textColor="#8192AD"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
